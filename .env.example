# ==============================================================================
# SIMPRO — Konfigurasi Environment Variables
# ==============================================================================
# CATATAN KEAMANAN:
# - Jangan pernah menaruh SUPABASE_SERVICE_ROLE_KEY atau SIMPRO_SESSION_SECRET
#   dengan prefix VITE_ karena variabel berprefix VITE_ terekspos ke browser.
# - Jangan commit file .env berisi kredensial asli ke repositori Git.
# ==============================================================================

# URL Aplikasi (diisi otomatis oleh runtime atau domain instansi HTTPS)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# SUPABASE (OPSIONAL SAAT PENGEMBANGAN LOKAL, WAJIB UNTUK PRODUCTION SUPABASE)
# Jika VITE_SUPABASE_URL dan VITE_SUPABASE_ANON_KEY kosong, aplikasi berjalan
# dalam Mode Lokal Terisolasi (SQLite + Express API) dengan penanda jelas.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-Only Secret (HANYA dibaca oleh Express server.ts, JANGAN prefix VITE_)
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# KEAMANAN SESI SERVER LOKAL
# Ganti dengan string acak minimal 32 karakter pada lingkungan staging/production
# ------------------------------------------------------------------------------
SIMPRO_SESSION_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-untuk-produksi"

# Path file database lokal untuk mode pengembangan/uji internal
SIMPRO_SQLITE_PATH="./data/simpro.db"

# Port server (default 3000)
PORT=3000

# ------------------------------------------------------------------------------
# GOOGLE MAPS PLATFORM (Diisi otomatis oleh AI Studio Secrets / environment)
# ------------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

